# Copy to .env for local development.

DATABASE_URL=postgresql+asyncpg://receipts:receipts@localhost:5432/receipts
DATA_DIR=./data

# --- extraction --------------------------------------------------------------
# Pick one engine and fill in only its key.
EXTRACTOR=openrouter

# openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# claude (Anthropic direct)
ANTHROPIC_API_KEY=
EXTRACTOR_MODEL=claude-opus-5
EXTRACTOR_EFFORT=medium

# --- auth --------------------------------------------------------------------
# Local development only. Never set this on a machine anyone else can reach.
AUTH_DISABLED=true
SECRET_KEY=dev-secret-not-for-real-use
# APP_PASSWORD_HASH=   # python scripts/hash_password.py
# API_KEY=             # openssl rand -hex 24
