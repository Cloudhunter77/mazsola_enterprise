# Copy to .env for local development.

DATABASE_URL=postgresql+asyncpg://leltar:leltar@localhost:5433/leltar
DATA_DIR=./data

# --- identification ----------------------------------------------------------
# Pick one engine and fill in only its key.
IDENTIFIER=claude

# claude (Anthropic direct)
ANTHROPIC_API_KEY=
IDENTIFIER_MODEL=claude-sonnet-5
IDENTIFIER_EFFORT=low

# openrouter (one account in front of Mistral, Qwen, Gemini and the rest)
OPENROUTER_API_KEY=
# No default: ids and prices change every few weeks. Run `python scripts/list_models.py`
# to see which models can do vision AND strict structured outputs today, cheapest first.
OPENROUTER_MODEL=

# The main cost lever: an image bills at about (width * height) / 750 tokens.
MAX_IMAGE_EDGE=1280
MAX_ITEMS_PER_PHOTO=12

# --- auth --------------------------------------------------------------------
# Local development only. Never set this on a machine anyone else can reach.
AUTH_DISABLED=true
SECRET_KEY=dev-secret-not-for-real-use
# APP_PASSWORD_HASH=   # python scripts/hash_password.py
# API_KEY=             # openssl rand -hex 24
