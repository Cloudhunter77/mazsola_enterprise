# Copy to .env for local development.

DATABASE_URL=postgresql+asyncpg://leltar:leltar@localhost:5433/leltar
DATA_DIR=./data

# --- identification ----------------------------------------------------------
IDENTIFIER=claude
ANTHROPIC_API_KEY=
IDENTIFIER_MODEL=claude-sonnet-5
IDENTIFIER_EFFORT=low

# The main cost lever: an image bills at about (width * height) / 750 tokens.
MAX_IMAGE_EDGE=1280
MAX_ITEMS_PER_PHOTO=12

# --- auth --------------------------------------------------------------------
# Local development only. Never set this on a machine anyone else can reach.
AUTH_DISABLED=true
SECRET_KEY=dev-secret-not-for-real-use
# APP_PASSWORD_HASH=   # python scripts/hash_password.py
# API_KEY=             # openssl rand -hex 24
